{
  "name": "dsh-skin-liquid-glass",
  "version": "0.2.9",
  "description": "iOS 26 Liquid Glass skin for DeepSeek Harness: one shared white-grey-blue fog, a single 40px frost over the whole window, a floating glass sidebar and reply bubbles.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "liushuchang-2012",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushuchang-2012/dsh-skin-liquid-glass.git"
  },
  "homepage": "https://github.com/liushuchang-2012/dsh-skin-liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/liushuchang-2012/dsh-skin-liquid-glass/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "client-plugin",
    "theme",
    "skin",
    "ios",
    "liquid-glass",
    "frosted-glass"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/bundle.test.mjs tests/manifest.test.mjs",
    "prepublishOnly": "node scripts/build.mjs && node --check client.js"
  },
  "files": [
    "lib",
    "client.js",
    "src",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "skin.css",
    "patches.css",
    "skin.json",
    "preview",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
